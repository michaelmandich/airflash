{
  "name": "airflash",
  "version": "0.1.0",
  "description": "AirDrop for everything else: temporary file and text sharing between your Windows PC, Mac and iPhone over the LAN, or through a self-hosted relay.",
  "author": "Michael Mandich",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/michaelmandich/airflash#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michaelmandich/airflash.git"
  },
  "bugs": {
    "url": "https://github.com/michaelmandich/airflash/issues"
  },
  "keywords": [
    "airdrop",
    "file-sharing",
    "lan",
    "electron",
    "capacitor",
    "raspberry-pi",
    "cloudflare-tunnel"
  ],
  "main": "src/desktop/main.js",
  "bin": {
    "airflash": "bin/airflash.js"
  },
  "scripts": {
    "start": "node bin/airflash.js",
    "desktop": "electron .",
    "icons": "node scripts/make-icons.js",
    "build:mobile": "node scripts/build-mobile.js",
    "test": "node --test test/*.test.js",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@capacitor-community/media": "9.1.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/file-transfer": "2.0.6",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/ios": "8.5.3",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/preferences": "8.0.0",
    "@capawesome/capacitor-file-picker": "8.1.0",
    "@capgo/capacitor-share-target": "8.0.60",
    "@capgo/capacitor-uploader": "8.3.24",
    "airflash-bonjour": "file:native/airflash-bonjour",
    "bonjour-service": "^1.3.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "0.25.10",
    "xcode": "3.0.1"
  },
  "build": {
    "appId": "app.airflash.desktop",
    "productName": "AirFlash",
    "files": [
      "src/**/*",
      "bin/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.png"
    }
  }
}
